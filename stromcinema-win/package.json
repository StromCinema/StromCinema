{
  "name": "strom",
  "productName": "Strom",
  "version": "1.0.0",
  "description": "Strøm – movie shelf with built-in server and mpv playback (Windows)",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-packager . Strom --platform=win32 --arch=x64 --icon=icon.ico --out=release --overwrite --asar --ignore=\"^/release\" && node finish.cjs"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "bonjour-service": "^1.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.1.0"
  }
}
